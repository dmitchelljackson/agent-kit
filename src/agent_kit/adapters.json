{
  "_comment": "Per-agent adapters. Override or add agents in .agent-kit.json or ~/.config/akit/config.json under \"adapters\". judge: headless command; {file} is replaced by the judge packet path, otherwise the packet is piped on stdin. verified: whether the command has been checked against the real CLI. protect: how akit blocks the agent from editing the owner-only share flag (null = file locks only).",
  "claude": {
    "label": "Claude Code",
    "skills_dir": ".claude/skills",
    "instructions_file": "CLAUDE.md",
    "judge": "claude -p --tools \"\"",
    "verified": true,
    "protect": {
      "type": "claude-settings"
    }
  },
  "codex": {
